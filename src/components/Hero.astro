---
import { Picture } from 'astro:assets';
import playa from '../assets/photos/playa.jpg';
import LemonSprig from './LemonSprig.astro';
import Olive from './Olive.astro';
import LangSwitcher from './LangSwitcher.astro';
import Nav from './Nav.astro';
import { event, startISO, type Locale } from '../config';
import { getDict, formatEventDate } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const date = formatEventDate(locale);
---

<header class="hero" id="top">
  <div class="tiles" aria-hidden="true"></div>
  <Nav locale={locale} />
  <LangSwitcher locale={locale} />

  <span class="branch branch--tl" aria-hidden="true"><LemonSprig width={300} id="hero-a" /></span>
  <span class="branch branch--br" aria-hidden="true"><LemonSprig width={280} id="hero-b" /></span>

  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow">
        <Olive width={64} flip />
        {t.hero.kicker}
        <Olive width={64} />
      </p>
      <h1 class="names">
        <span>{event.groom}</span>
        <span class="amp script" aria-hidden="true">&amp;</span>
        <span class="sr-only">&amp;</span>
        <span>{event.bride}</span>
      </h1>
      <p class="tagline script">{t.hero.tagline}</p>
      <div class="rule" aria-hidden="true"></div>
      <p class="date">
        <time datetime={startISO}>{date}</time>
      </p>
      <p class="place">{t.hero.place}</p>
      <div class="ctas">
        <a class="btn btn--lemon" href="#rsvp">{t.hero.cta}</a>
        <a class="btn btn--ghost" href={event.venue.mapsUrl} target="_blank" rel="noopener">{t.hero.ctaMap}</a>
      </div>
    </div>

    <div class="arch-frame">
      <figure class="arch">
        <Picture
          src={playa}
          formats={['avif', 'webp']}
          width={688}
          alt={t.hero.photoAlt}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>

  <a class="scroll" href="#countdown" aria-label={t.hero.scroll}>
    <span>{t.hero.scroll}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 4v16m0 0l-6-6m6 6l6-6"></path>
    </svg>
  </a>
</header>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: grid;
    align-content: center;
    padding-block: clamp(96px, 13vw, 140px) clamp(72px, 10vw, 110px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero > .tiles {
    position: absolute;
    inset: 0 0 auto 0;
  }

  .branch {
    position: absolute;
    z-index: -1;
    line-height: 0;
    opacity: 0.95;
  }

  /* La rama cuelga desde arriba a la izquierda, como en una pérgola de limones */
  .branch--tl {
    top: calc(var(--tile) + 18px);
    left: -40px;
    transform: rotate(-150deg) scaleX(-1);
  }

  .branch--br {
    right: 12px;
    bottom: 30px;
    transform: rotate(-6deg);
  }

  .hero__grid {
    display: grid;
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
  }

  .hero__text {
    text-align: center;
  }

  /* "Ci sposiamo" más grande que los demás rótulos: es el anuncio */
  .hero__text .eyebrow {
    font-size: clamp(0.95rem, 2.6vw, 1.2rem);
    gap: 14px;
  }

  .eyebrow :global(.olive) {
    opacity: 0.9;
    width: 46px;
    height: auto;
  }

  @media (min-width: 720px) {
    .eyebrow :global(.olive) {
      width: 64px;
    }
  }

  .names {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(3.4rem, 11vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
    margin-top: 18px;
    letter-spacing: -0.01em;
  }

  .amp {
    color: var(--lemon-deep);
    font-size: 0.7em;
    line-height: 0.9;
    margin-block: 0.05em;
  }

  .tagline {
    margin-top: 14px;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .date {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem);
  }

  .place {
    margin-top: 6px;
    font-size: 0.82rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  /* Foto en arco con marco de mayólica: el motivo clásico de la papelería italiana */
  .arch-frame {
    margin: 0 auto;
    width: min(82vw, 380px);
    padding: var(--tile);
    background-image: var(--pat-majolica);
    background-size: var(--tile) var(--tile);
    border-radius: 999px 999px var(--radius) var(--radius);
    border: 1px solid var(--blue);
    box-shadow: var(--shadow);
  }

  .arch {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px calc(var(--radius) - 8px) calc(var(--radius) - 8px);
    overflow: hidden;
    outline: 1px solid var(--blue);
    background: var(--line);
  }

  .arch :global(picture) {
    position: absolute;
    inset: 0;
  }

  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .scroll svg {
    width: 18px;
    height: 18px;
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 819px) {
    .branch :global(svg) {
      width: 230px;
      height: auto;
    }

    .branch :global(svg) {
      width: 200px;
    }

    .branch--tl {
      left: -55px;
      top: calc(var(--tile) - 40px);
    }

    .branch--tl :global(svg) {
      width: 160px;
    }

    .branch--br {
      right: -50px;
      bottom: 8px;
    }

    .hero {
      padding-top: calc(var(--tile) + 96px);
    }
  }

  @media (min-width: 820px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hero__text {
      text-align: left;
      padding-top: 48px;
    }

    /* La rama sube y se corre para no tapar el "Ci sposiamo", ahora más grande */
    .branch--tl {
      left: -120px;
      top: calc(var(--tile) - 90px);
    }

    .branch--tl :global(svg) {
      width: 260px;
    }

    .names {
      align-items: flex-start;
    }

    .rule {
      margin-inline: 0;
    }

    .ctas {
      justify-content: flex-start;
    }

    .arch-frame {
      width: min(100%, 440px);
      margin-right: 0;
    }
  }
</style>
