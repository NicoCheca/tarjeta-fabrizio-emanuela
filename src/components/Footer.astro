---
import Monogram from './Monogram.astro';
import type { Locale } from '../config';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
---

<footer class="footer center">
  <Monogram size={110} />
  <p class="names">{t.footer.text}</p>
  <p class="date">{t.footer.date}</p>
  <div class="tiles" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 56px var(--gutter) 0;
  }

  .names {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
  }

  .date {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: var(--ink-soft);
  }

  .footer .tiles {
    width: 100%;
    margin-top: 40px;
  }
</style>
