---
import { Picture } from 'astro:assets';
import noche from '../assets/photos/noche.jpg';
import anillo from '../assets/photos/anillo.jpg';
import atardecer from '../assets/photos/atardecer.jpg';
import type { Locale } from '../config';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="section section--cream center" id="story" aria-labelledby="story-title">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t.story.title}</p>
      <h2 class="title" id="story-title">{t.story.title}</h2>
      <p class="lead">{t.story.text}</p>
    </div>

    <div class="gallery">
      <figure class="reveal">
        <Picture src={noche} formats={['avif', 'webp']} width={700} alt={t.story.alts.noche} loading="lazy" />
      </figure>
      <figure class="reveal feature">
        <Picture src={anillo} formats={['avif', 'webp']} width={900} alt={t.story.alts.anillo} loading="lazy" />
      </figure>
      <figure class="reveal">
        <Picture src={atardecer} formats={['avif', 'webp']} width={700} alt={t.story.alts.atardecer} loading="lazy" />
      </figure>
    </div>
  </div>
</section>

<style>
  .gallery {
    display: grid;
    gap: 16px;
    margin-top: 44px;
  }

  figure {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--line);
    box-shadow: var(--shadow);
  }

  figure :global(picture) {
    height: 100%;
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: 1fr 1.4fr 1fr;
      align-items: center;
    }

    .feature {
      aspect-ratio: 4 / 5;
    }

    figure:not(.feature) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
