---
import { Picture } from 'astro:assets';
import noche from '../assets/photos/noche.jpg';
import anillo from '../assets/photos/anillo.jpg';
import atardecer from '../assets/photos/atardecer.jpg';
import type { Locale } from '../config';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
---

<section class="section section--cream center" id="story" aria-labelledby="story-title">
  <div class="awning awning--top" aria-hidden="true"></div>
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t.story.eyebrow}</p>
      <h2 class="title" id="story-title">{t.story.title}</h2>
      <p class="lead">{t.story.text}</p>
    </div>

    <!-- Fotos con paspartú blanco, como copias impresas sobre la mesa -->
    <div class="gallery">
      <figure class="print print--noche reveal">
        <Picture src={noche} formats={['avif', 'webp']} width={700} alt={t.story.alts.noche} loading="lazy" />
      </figure>
      <figure class="print print--feature print--anillo reveal">
        <Picture src={anillo} formats={['avif', 'webp']} width={900} alt={t.story.alts.anillo} loading="lazy" />
      </figure>
      <figure class="print print--atardecer reveal">
        <Picture src={atardecer} formats={['avif', 'webp']} width={700} alt={t.story.alts.atardecer} loading="lazy" />
      </figure>
    </div>
  </div>
  <div class="awning awning--bottom" aria-hidden="true"></div>
</section>

<style>
  .awning--top {
    position: absolute;
    inset: 0 0 auto 0;
  }

  .awning--bottom {
    position: absolute;
    inset: auto 0 0 0;
    border-bottom: 0;
    border-top: 1px solid var(--blue);
  }

  .awning--bottom::after {
    top: auto;
    bottom: 100%;
    background-position: 0 100%;
    background-image: radial-gradient(circle at 12px 12px, var(--blue) 10px, transparent 11px);
  }

  .awning {
    position: absolute;
  }

  .gallery {
    display: grid;
    gap: 22px;
    margin-top: 44px;
  }

  /*
    Paspartú blanco con la foto en posición absoluta adentro: el tamaño lo fija
    el aspect-ratio del figure, nunca la imagen. Safari calculaba mal la
    combinación aspect-ratio + height:100% y desbordaba la pantalla.
  */
  .print {
    position: relative;
    margin: 0;
    width: 100%;
    min-width: 0;
    padding: 10px 10px 14px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .print :global(picture) {
    position: absolute;
    inset: 10px 10px 14px;
  }

  .print :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* En celular, cada foto con un formato cercano al original para no cortar caras */
  .print--noche {
    aspect-ratio: 5 / 6;
  }

  .print--noche :global(img) {
    object-position: 50% 25%;
  }

  .print--anillo {
    aspect-ratio: 4 / 3;
  }

  .print--anillo :global(img) {
    object-position: 50% 35%;
  }

  .print--atardecer {
    aspect-ratio: 4 / 3;
  }

  .print--atardecer :global(img) {
    object-position: 50% 30%;
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: 1fr 1.35fr 1fr;
      align-items: center;
    }

    .print {
      aspect-ratio: 4 / 5;
      rotate: -2.5deg;
    }

    .print:last-child {
      rotate: 2.5deg;
    }

    .print--feature {
      rotate: 0deg;
      z-index: 1;
    }
  }
</style>
