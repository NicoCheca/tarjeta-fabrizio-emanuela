---
import { event, type Locale } from '../config';
import { getDict, whatsappUrl } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const playlistHref = event.playlistUrl || whatsappUrl(t.info.playlist.message);
const showGift = Boolean(event.gift.iban);
---

<section class="section center" id="info" aria-labelledby="info-title">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t.info.title}</p>
      <h2 class="title" id="info-title">{t.info.title}</h2>
    </div>

    <div class="grid">
      <article class="card reveal">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3l4 2 4-2 4 5-3 2v11H7V10L4 8z"></path>
          </svg>
        </span>
        <h3>{t.info.dress.title}</h3>
        <p>{t.info.dress.text}</p>
      </article>

      {
        showGift && (
          <article class="card reveal">
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="8" width="18" height="13" rx="2" />
                <path d="M3 12h18M12 8v13M12 8c-2-4-6-4-6-1s4 1 6 1zm0 0c2-4 6-4 6-1s-4 1-6 1z" />
              </svg>
            </span>
            <h3>{t.info.gifts.title}</h3>
            <p>{t.info.gifts.text}</p>
            <dl class="bank">
              <dt>{t.info.gifts.iban}</dt>
              <dd>
                <code>{event.gift.iban}</code>
                <button
                  class="copy"
                  type="button"
                  data-copy={event.gift.iban.replace(/\s/g, '')}
                  data-copied={t.info.gifts.copied}
                >
                  {t.info.gifts.copy}
                </button>
              </dd>
              <dt>{t.info.gifts.holder}</dt>
              <dd>{event.gift.holder}</dd>
            </dl>
          </article>
        )
      }

      <article class="card reveal">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18V6l11-2v12"></path>
            <circle cx="6.5" cy="18" r="2.5"></circle>
            <circle cx="17.5" cy="16" r="2.5"></circle>
          </svg>
        </span>
        <h3>{t.info.playlist.title}</h3>
        <p>{t.info.playlist.text}</p>
        <a class="btn btn--ghost" href={playlistHref} target="_blank" rel="noopener">{t.info.playlist.cta}</a>
      </article>

      <article class="card reveal">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"></path>
          </svg>
        </span>
        <h3>{t.info.stay.title}</h3>
        <p>{t.info.stay.text}</p>
        <a class="btn btn--ghost" href={event.venue.website} target="_blank" rel="noopener">{t.info.stay.cta}</a>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 20px;
    margin-top: 40px;
    text-align: left;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(24px, 3vw, 34px);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--lemon);
    color: var(--ink);
  }

  .icon svg {
    width: 22px;
    height: 22px;
  }

  .card h3 {
    font-size: 1.6rem;
    font-style: italic;
  }

  .card p {
    color: var(--ink-soft);
  }

  .card .btn {
    justify-self: start;
    margin-top: 6px;
  }

  .bank {
    margin: 4px 0 0;
    display: grid;
    gap: 2px;
  }

  .bank dt {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 8px;
  }

  .bank dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  code {
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: 0.04em;
    word-break: break-all;
  }

  .copy {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--cream);
    font-size: 0.78rem;
    cursor: pointer;
  }

  .copy[data-done] {
    background: var(--lemon);
    border-color: var(--lemon);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
