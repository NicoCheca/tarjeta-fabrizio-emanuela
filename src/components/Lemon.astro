---
/** Limón con hojas, en línea fina. Decorativo: no lo leen los lectores de pantalla. */
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 64 } = Astro.props;
---

<svg
  class:list={['lemon', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- fruto -->
  <path
    d="M30 62c-6-10-3-26 9-33 10-6 25-5 32 4 7 8 8 22 1 31-8 10-24 12-34 6-3-2-6-5-8-8z"
    fill="var(--lemon)"
    stroke="var(--lemon-deep)"></path>
  <path d="M71 32c3-2 6-2 8-1M29 63c-3 2-5 4-6 7" stroke="var(--lemon-deep)"></path>
  <!-- hojas -->
  <path d="M46 30c-2-12 6-20 18-20 1 11-6 19-18 20z" fill="#dfe8d8" stroke="var(--leaf)"></path>
  <path d="M46 30c6-6 11-11 16-16" stroke="var(--leaf)"></path>
  <path d="M40 34c-12-1-19-9-19-19 10 0 18 7 19 19z" fill="#dfe8d8" stroke="var(--leaf)"></path>
  <path d="M40 34c-5-5-10-10-15-15" stroke="var(--leaf)"></path>
</svg>
