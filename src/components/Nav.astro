---
/**
 * Navegación mínima: en escritorio, monograma y cuatro enlaces bajo la cinta;
 * en celular, el monograma arriba y una barra fija abajo que aparece al
 * pasar la portada, con "Conferma" siempre a mano.
 */
import Monogram from './Monogram.astro';
import type { Locale } from '../config';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const links = [
  ['#event', t.nav.event],
  ['#story', t.nav.story],
  ['#info', t.nav.info],
] as const;
---

<nav class="topnav" aria-label={t.nav.event}>
  <a class="seal" href="#top" aria-label="Fabrizio & Emanuela">
    <Monogram size={46} />
  </a>
  <ul class="links">
    {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    <li><a href="#rsvp" class="links__rsvp">{t.nav.rsvp}</a></li>
  </ul>
</nav>

<nav class="dock" data-dock aria-label={t.nav.rsvp}>
  {links.map(([href, label]) => <a href={href}>{label}</a>)}
  <a href="#rsvp" class="dock__rsvp">{t.nav.rsvp}</a>
</nav>

<style>
  /* En celular no hay menú arriba: navega la barra fija de abajo */
  .topnav {
    display: none;
    position: absolute;
    top: calc(var(--tile) + 10px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    align-items: center;
    gap: 22px;
  }

  .seal {
    display: block;
    line-height: 0;
    background: rgb(255 253 248 / 0.8);
    border-radius: 50%;
  }

  .links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 22px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .links a {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 6px 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .links a:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .links__rsvp {
    color: var(--blue) !important;
  }

  /* Barra fija de celular */
  .dock {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgb(255 253 248 / 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transform: translateY(calc(100% + 24px));
    transition: transform 0.35s ease;
  }

  .dock.show {
    transform: none;
  }

  .dock a {
    display: grid;
    place-items: center;
    min-height: 40px;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .dock__rsvp {
    background: var(--lemon);
    color: var(--ink) !important;
    border: 1px solid var(--lemon-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .dock {
      transition: none;
    }
  }

  @media (min-width: 820px) {
    .topnav,
    .links {
      display: flex;
    }

    .dock {
      display: none;
    }
  }
</style>
