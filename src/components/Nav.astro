---
/**
 * Navegación mínima de escritorio: monograma y cuatro enlaces bajo la cinta.
 * En celular no se muestra; navega la barra fija de Dock.astro.
 */
import Monogram from './Monogram.astro';
import type { Locale } from '../config';
import { getDict } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const links = [
  ['#event', t.nav.event],
  ['#story', t.nav.story],
  ['#info', t.nav.info],
] as const;
---

<nav class="topnav" aria-label={t.nav.event}>
  <a class="seal" href="#top" aria-label="Fabrizio & Emanuela">
    <Monogram size={46} />
  </a>
  <ul class="links">
    {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    <li><a href="#rsvp" class="links__rsvp">{t.nav.rsvp}</a></li>
  </ul>
</nav>

<style>
  /* En celular no hay menú arriba: navega la barra fija de abajo */
  .topnav {
    display: none;
    position: absolute;
    top: calc(var(--tile) + 10px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    align-items: center;
    gap: 22px;
  }

  .seal {
    display: block;
    line-height: 0;
    background: rgb(255 253 248 / 0.8);
    border-radius: 50%;
  }

  .links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 22px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .links a {
    text-decoration: none;
    color: var(--ink-soft);
    padding: 6px 2px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .links a:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .links__rsvp {
    color: var(--blue) !important;
  }

  @media (min-width: 820px) {
    .topnav,
    .links {
      display: flex;
    }
  }
</style>
