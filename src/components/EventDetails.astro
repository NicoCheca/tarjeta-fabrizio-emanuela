---
import Olive from './Olive.astro';
import Schedule from './Schedule.astro';
import { event, startISO, endISO, hasTime, dateEnd, type Locale } from '../config';
import { getDict, formatEventDate } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const date = formatEventDate(locale);

const toGcal = (iso: string) => new Date(iso).toISOString().replace(/[-:]|\.\d{3}/g, '');
const ymd = (s: string) => s.replace(/-/g, '');
const title = `${t.event.title} · ${event.groom} & ${event.bride}`;
const location = `${event.venue.name}, ${event.venue.street}, ${event.venue.town}, ${event.venue.region}`;
// Sin hora confirmada, el evento se agenda como día completo.
const gcalDates = hasTime ? `${toGcal(startISO)}/${toGcal(endISO)}` : `${ymd(event.date)}/${ymd(dateEnd)}`;
const gcal =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(title)}` +
  `&dates=${gcalDates}` +
  `&location=${encodeURIComponent(location)}` +
  `&ctz=${event.timeZone}`;
---

<section class="section center" id="event" aria-labelledby="event-title">
  <div class="container reveal">
    <p class="eyebrow">{t.event.title}</p>
    <h2 class="title" id="event-title">
      {event.groomFull} <span class="amp script">&amp;</span> {event.brideFull}
    </h2>

    <div class="cards">
      <article class="card">
        <div class="tiles" aria-hidden="true"></div>
        <div class="card__body">
          <h3>{t.event.when}</h3>
          <Olive width={90} />
          <p class="big"><time datetime={hasTime ? startISO : event.date}>{date}</time></p>
          {
            hasTime ? (
              <dl class="times">
                <div>
                  <dt>{t.event.ceremony}</dt>
                  <dd>
                    {t.event.at} {event.ceremonyTime}
                  </dd>
                </div>
                {event.receptionTime && (
                  <div>
                    <dt>{t.event.reception}</dt>
                    <dd>
                      {t.event.at} {event.receptionTime}
                    </dd>
                  </div>
                )}
              </dl>
            ) : (
              <p class="tbd">{t.event.timeTbd}</p>
            )
          }
          <button
            class="btn"
            type="button"
            data-ics
            data-ics-title={title}
            data-ics-date={event.date}
            data-ics-date-end={dateEnd}
            data-ics-allday={hasTime ? '0' : '1'}
            data-ics-start={startISO}
            data-ics-end={endISO}
            data-ics-location={location}
            data-ics-gcal={gcal}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="3"></rect>
              <path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5"></path>
            </svg>
            {t.event.addToCalendar}
          </button>
        </div>
      </article>

      <article class="card">
        <div class="tiles" aria-hidden="true"></div>
        <div class="card__body">
          <h3>{t.event.where}</h3>
          <Olive width={90} />
          <p class="big">{event.venue.name}</p>
          <p class="addr">
            {event.venue.street}<br />
            {event.venue.town}<br />
            {event.venue.region}
          </p>
          <p class="note">{t.event.venueNote}</p>
          <p class="officiants">{t.event.officiants}</p>
          <p class="travel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M2.5 19h19M3.8 13.5l16.7-6.2a1.5 1.5 0 0 1 1 2.8L15 13l-3.3 4.5-1.9-.6.8-4.2-4-.1-1.9 1.4-1-.5z"></path>
            </svg>
            <span>{t.event.travel.text}</span>
          </p>
          <a class="btn btn--ghost" href={event.venue.mapsUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z"></path>
              <circle cx="12" cy="10" r="2.2"></circle>
            </svg>
            {t.event.directions}
          </a>
        </div>
      </article>
    </div>

    <Schedule locale={locale} />
  </div>
</section>

<style>
  .title {
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
  }

  .amp {
    font-size: 1.3em;
    color: var(--lemon-deep);
  }

  .cards {
    display: grid;
    gap: 24px;
    margin-top: 40px;
  }

  .card {
    background: var(--paper);
    border: 1px solid var(--blue);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .card__body {
    display: grid;
    align-content: center;
    height: calc(100% - var(--tile));
    justify-items: center;
    gap: 10px;
    padding: clamp(26px, 4vw, 40px) clamp(20px, 3vw, 36px);
  }

  .card h3 {
    font-size: 0.76rem;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .big {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
  }

  .times {
    display: flex;
    gap: 28px;
    margin: 6px 0 0;
  }

  .times div {
    display: grid;
  }

  .times dt {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .times dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .travel {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    text-align: left;
    max-width: 40ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .travel svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--blue);
    margin-top: 2px;
  }

  .officiants {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 34ch;
  }

  .tbd,
  .addr {
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .tbd {
    font-style: italic;
  }

  .note {
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--olive-deep);
  }

  .card .btn {
    margin-top: 12px;
  }

  @media (min-width: 720px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
