---
import LemonSprig from './LemonSprig.astro';
import type { Locale } from '../config';
import { getDict, formatDeadline, contactLinks } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const deadline = formatDeadline(locale);
const text = deadline ? t.rsvp.text.replace('{deadline}', deadline) : t.rsvp.textNoDeadline;
const links = contactLinks(t.rsvp.message);
---

<section class="section center" id="rsvp" aria-labelledby="rsvp-title">
  <div class="container reveal">
    <div class="tile-frame frame">
      <div class="box">
        <span class="branch" aria-hidden="true"><LemonSprig width={170} id="rsvp" /></span>
        <p class="eyebrow">{t.rsvp.eyebrow}</p>
        <h2 class="title" id="rsvp-title">{t.rsvp.title}</h2>
        <p class="lead">{links.length ? text : t.rsvp.pending}</p>
        <div class="buttons">
        {links.map((c) => (
        <a class="btn btn--lemon" href={c.href} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.8 11.8 0 0 0 4.5 4c1.7.7 2.1.6 2.8.5a2.4 2.4 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.4-.3z"
            ></path>
          </svg>
          {t.rsvp.cta} · {c.name}
        </a>
        ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .frame {
    max-width: 820px;
    margin-inline: auto;
    box-shadow: var(--shadow);
  }

  .box {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 80px) clamp(22px, 5vw, 64px);
    background: var(--paper);
  }

  .branch {
    position: absolute;
    right: 22px;
    top: 16px;
    opacity: 0.7;
    transform: scaleX(-1);
    line-height: 0;
    pointer-events: none;
  }

  .box > * {
    position: relative;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
</style>
