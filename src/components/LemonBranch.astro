---
/**
 * Rama de limonero con tres limones, hojas y dos flores de azahar.
 * Estilo acuarela-ilustración botánica, el motivo clásico de las invitaciones de la costa amalfitana.
 * Decorativa: aria-hidden.
 */
interface Props {
  class?: string;
  width?: number;
}
const { class: className = '', width = 300 } = Astro.props;
const id = `lb-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class:list={['lemon-branch', className]}
  width={width}
  height={width * 0.72}
  viewBox="0 0 300 216"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <defs>
    <radialGradient id={`${id}-lemon`} cx="38%" cy="32%" r="70%">
      <stop offset="0" stop-color="#FBE88A"></stop>
      <stop offset="0.55" stop-color="#F4D23C"></stop>
      <stop offset="1" stop-color="#D9AD2A"></stop>
    </radialGradient>
    <linearGradient id={`${id}-leaf`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8FA35A"></stop>
      <stop offset="1" stop-color="#5E7F3F"></stop>
    </linearGradient>
  </defs>

  <!-- ramas -->
  <g stroke="#6B5A3E" stroke-width="2.6">
    <path d="M8 24c40 10 86 30 128 58 30 20 60 46 92 70"></path>
    <path d="M86 56c14-12 30-18 50-20"></path>
    <path d="M150 92c-6 18-4 34 4 48"></path>
    <path d="M190 118c16-4 30-2 44 6"></path>
  </g>

  <!-- hojas -->
  <g fill={`url(#${id}-leaf)`} stroke="#4E6A33" stroke-width="1.4">
    <path d="M40 30c18-14 40-14 52-2-14 10-36 12-52 2z"></path>
    <path d="M70 60c-2-20 10-36 26-40 2 18-8 34-26 40z"></path>
    <path d="M104 44c16-12 36-10 48 2-14 8-34 8-48-2z"></path>
    <path d="M122 82c-16-6-26-22-22-40 16 6 26 22 22 40z"></path>
    <path d="M166 70c14-14 36-14 50-2-12 10-34 12-50 2z"></path>
    <path d="M176 128c-18-2-30-16-30-34 18 2 30 16 30 34z"></path>
    <path d="M214 96c14-12 34-10 46 4-14 8-32 6-46-4z"></path>
    <path d="M232 156c-18 0-32-12-36-30 18 0 32 12 36 30z"></path>
    <path d="M250 134c12-14 32-16 46-4-12 10-32 12-46 4z"></path>
    <path d="M20 34c-8-14-6-30 6-32 8 12 6 26-6 32z"></path>
  </g>
  <!-- nervaduras -->
  <g stroke="#4E6A33" stroke-width="1" opacity="0.8">
    <path d="M42 30c16-6 32-8 48-4M72 58c6-12 14-24 22-34M106 44c14-4 30-4 44 0M120 80c-6-12-10-24-10-36M168 70c16-6 32-8 48-6M176 126c-6-10-10-20-12-30M216 96c14-4 30-4 44 2M232 154c-8-10-14-20-18-30M252 134c14-6 28-8 42-6"></path>
  </g>

  <!-- limones -->
  <g fill={`url(#${id}-lemon)`} stroke="#B8901C" stroke-width="1.6">
    <path d="M112 112c-18-4-30-20-26-38 4-14 20-22 36-18 16 4 26 20 22 36-4 16-18 24-32 20z"></path>
    <path d="M86 78c-3 1-6 3-8 6M146 98c3 0 6 2 8 5"></path>
    <path d="M204 182c-18-4-30-20-26-38 4-14 20-22 36-18 16 4 26 20 22 36-4 16-18 24-32 20z"></path>
    <path d="M178 148c-3 1-6 3-8 6M238 168c3 0 6 2 8 5"></path>
    <path d="M60 134c-14-4-22-16-18-30 3-12 16-18 28-14 12 4 20 16 16 30-3 12-14 18-26 14z"></path>
    <path d="M40 106c-2 1-4 2-6 4M86 122c2 0 4 2 5 4"></path>
  </g>
  <!-- brillo -->
  <g stroke="#FFF6C2" stroke-width="2.2" opacity="0.8">
    <path d="M98 70c-6 2-10 8-10 14M190 140c-6 2-10 8-10 14M50 100c-4 2-6 6-6 10"></path>
  </g>

  <!-- azahar -->
  <g fill="#FFFDF8" stroke="#D8CBB3" stroke-width="1">
    <g transform="translate(160 40)">
      <ellipse rx="4" ry="7" transform="rotate(0)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(72)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(144)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(216)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(288)"></ellipse>
      <circle r="2.4" fill="#F4D23C" stroke="none"></circle>
    </g>
    <g transform="translate(246 118) scale(0.8)">
      <ellipse rx="4" ry="7" transform="rotate(20)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(92)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(164)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(236)"></ellipse>
      <ellipse rx="4" ry="7" transform="rotate(308)"></ellipse>
      <circle r="2.4" fill="#F4D23C" stroke="none"></circle>
    </g>
  </g>
</svg>
